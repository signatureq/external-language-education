DirectoryIndex index.html index.php
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{HTTP_HOST} ^www\.externlangschool\.ru$ [NC]
RewriteRule ^ https://externlangschool.ru%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^externlangschool\.ru$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ https://externlangschool.ru/ [R=301,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(?:sqlite|sql|zip|tar|gz|log|bak|cms-tmp)$ - [F,L,NC]
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTP:x-xsrf-token} .
RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
</IfModule>
