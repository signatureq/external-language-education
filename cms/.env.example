APP_NAME="External · управление сайтом"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8008
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# On Timeweb use an absolute private path, outside public_html:
# DB_DATABASE=/home/c/cw704626/external/ele-cms/database/database.sqlite
# CMS_PUBLIC_PATH=/home/c/cw704626/external/public_html
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Enable for HTTPS hosting:
# SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
# Production applications: fixed recipient, separate from the sender mailbox.
APPLICATIONS_ENABLED=false
APPLICATIONS_RECIPIENT=
APPLICATIONS_ENDPOINT=
APPLICATIONS_ORIGINS=https://externlangschool.ru
# MAIL_MAILER=sendmail
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
# MAIL_FROM_ADDRESS=hosting-login@hosting-server.timeweb.ru
# MAIL_FROM_NAME="External Language Education"
# Authenticated Timeweb SMTP (configure-smtp.php keeps the recipient unchanged):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.timeweb.ru
# MAIL_PORT=465
# MAIL_USERNAME=notifications@externlangschool.ru
# MAIL_PASSWORD=
# MAIL_EHLO_DOMAIN=externlangschool.ru
# MAIL_TIMEOUT=15
# MAIL_FROM_ADDRESS=notifications@externlangschool.ru
# A one-time setup link is generated by: php artisan site:setup-link
# Production: separate admin domain and signed publication to the main website.
# APP_URL=https://cw704626.tw1.ru
# CMS_SEPARATE_DOMAIN=true
# CMS_SITE_URL=https://externlangschool.ru
# CMS_MEDIA_URL=https://cw704626.tw1.ru
# CMS_PUBLISHING_KEY=/absolute/private/path/publishing-private.pem
